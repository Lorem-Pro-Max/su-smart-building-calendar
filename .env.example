# Backend
PORT=8112

# ต้องชี้ไปที่ DB เดียวกับ admin dashboard (ใช้ตาราง room, room_booking, user ร่วมกัน)
# host 172.20.0.1 คือ gateway ของ network ที่ตรึงไว้ใน docker-compose.yml
DATABASE_URL=postgresql://smartbuilding_admin:CHANGE-ME@172.20.0.1:5432/smartbuilding

# Frontend (Vite build-time var — ต้องเป็น https เพราะ nginx ฝั่งหน้าบ้าน redirect http ทั้งหมด)
VITE_API_BASE=https://55.sc.su.ac.th/booking-calendar/api
